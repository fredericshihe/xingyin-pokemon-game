# Copy to .env.local for local development.
# On Cloudflare Pages, set these as Project → Settings → Environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 生产（pokemongame.site）根路径：
# VITE_BASE_PATH=/

# Optional: enable map runtime preview route in production builds
# VITE_ENABLE_MAP_RUNTIME_PREVIEW=false

# Long-term progression rollout flags. Keep false until the matching migration
# and verification phase has completed; development mode enables local previews.
VITE_ENABLE_PERMANENT_DEX_V1=false
VITE_ENABLE_MAP_PROGRESS_V1=false
VITE_ENABLE_COMPLETION_REWARDS_V1=false
VITE_ENABLE_ELITE_UNLOCK_TASKS_V1=false
VITE_ENABLE_CHAMPION_TOWER_V1=false
