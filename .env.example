# Copy to .env.local for local development.
# On Cloudflare Pages, set these as Project → Settings → Environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 静态资源根路径：GitHub Pages 项目页（默认）填 /xingyin-pokemon-game/
# Cloudflare Pages 根域名部署填 /
# VITE_BASE_PATH=/xingyin-pokemon-game/

# Optional: enable map runtime preview route in production builds
# VITE_ENABLE_MAP_RUNTIME_PREVIEW=false
