    "prebuild": "npm run copy:draco && npm run generate:map-manifest",
    "generate:map": "node scripts/generate-map.mjs",
    "generate:learnsets": "node scripts/generate-official-learnsets.mjs",
    "generate:economy": "node scripts/generate-official-economy-data.mjs",
    "generate:extra-moves": "node scripts/generate-official-extra-moves.mjs",
