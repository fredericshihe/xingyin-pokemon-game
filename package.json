    "audit:mp": "node scripts/audit-mp-balance.mjs",
    "audit:moves": "node scripts/audit-move-secondary-effects.mjs",
    "audit:move-visuals": "node scripts/audit-move-visuals.mjs",
    "audit:learnsets": "node scripts/audit-learnset-coverage.mjs",
    "audit:exp-overflow": "node scripts/audit-exp-overflow.mjs",
    "audit:evolutions": "node scripts/audit-official-evolutions.mjs",
